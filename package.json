{
  "name": "weatherbot-app",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf dist",
    "build": "vite build && node scripts/check-bundle-for-secrets.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "type-check": "tsc -b --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:smoke": "vitest run evals/driverSmoke.test.ts",
    "eval:corpus": "vitest run evals/corpus.test.ts"
  },
  "dependencies": {
    "@andyfooblah/voice-common": "^0.15.0",
    "@google/genai": "^2.32.0",
    "firebase": "^12.9.0",
    "nl2time": "^0.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@langchain/google-genai": "^2.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.58.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "agentevals": "^0.0.7",
    "autoevals": "^0.4.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.14.0",
    "google-auth-library": "^11.3.3",
    "openevals": "^0.2.3",
    "tailwindcss": "^4.2.0",
    "typescript": "~7.0.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "ts-api-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@grpc/grpc-js": "^1.14.0"
  }
}
